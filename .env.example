# LLM provider (Gemini)
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash. Override if that model is ever
# deprecated/retired (Google does this on short notice for free-tier models).
GEMINI_MODEL=

# Web search for public discussion of a company's interview process
TAVILY_API_KEY=

# MongoDB connection string
MONGODB_URI=

# Session/auth secret
SESSION_SECRET=

# Set to "production" to enforce SSRF guards (reject private/loopback hosts).
# Leave unset or "development" locally so the batch CLI can hit localhost fixtures.
NODE_ENV=development

# apps/api
PORT=4000
# Origin of the deployed frontend, for CORS (credentialed requests can't use "*")
FRONTEND_URL=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
