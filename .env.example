# LLM provider (Gemini)
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash-lite (the free tier's 15 RPM / 500 RPD
# bucket; the plain "Flash" models share a much tighter 5 RPM / 20 RPD bucket).
# Override if this model is ever deprecated/retired, which Google does on short
# notice for free-tier models — check https://aistudio.google.com/rate-limit.
GEMINI_MODEL=

# Web search for public discussion of a company's interview process
TAVILY_API_KEY=

# MongoDB connection string
MONGODB_URI=

# Session/auth secret
SESSION_SECRET=

# Set to "production" to enforce SSRF guards (reject private/loopback hosts).
# Leave unset or "development" locally so the batch CLI can hit localhost fixtures.
NODE_ENV=development

# apps/api
PORT=4000
# Origin of the deployed frontend, for CORS (credentialed requests can't use "*")
FRONTEND_URL=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
